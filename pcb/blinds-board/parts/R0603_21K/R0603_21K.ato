    trait is_atomic_part<manufacturer="UNI-ROYAL(Uniroyal Elec)", partnumber="0603WAF2102T5E", footprint="R0603.kicad_mod", symbol="0603WAF2102T5E.kicad_sym">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C22956", manufacturer="UNI-ROYAL(Uniroyal Elec)", partno="0603WAF2102T5E">
    trait has_designator_prefix<prefix="R">

    # pins
    pin 1
    pin 2
