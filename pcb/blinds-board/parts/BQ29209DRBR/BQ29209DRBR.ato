#pragma experiment("TRAITS")
import has_designator_prefix
import has_part_picked
import is_atomic_part

component BQ29209DRBR_package:
    """
    BQ29209 — 2-series secondary (redundant) overvoltage protector with an
    internal cell-balance path, SON-8 3x3mm. It watches each cell against a
    fixed OV threshold and above it drives OUT high; with CB_EN asserted it
    also bleeds the higher cell through the VC1_CB/VC2 balance pins.
    Last line of defence behind the charger's own termination.
    """
    trait is_atomic_part<manufacturer="Texas Instruments", partnumber="BQ29209DRBR", footprint="SON-8_L3.0-W3.0-P0.65-LS3.0-BL-EP.kicad_mod", symbol="BQ29209DRBR.kicad_sym">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C139352", manufacturer="Texas Instruments", partno="BQ29209DRBR">
    trait has_designator_prefix<prefix="U">

    # pins
    signal VC2 ~ pin 1  # top cell +
    signal VC1 ~ pin 2  # cell midpoint
    signal VC1_CB ~ pin 3  # midpoint balance return
    signal CD ~ pin 4  # charge/discharge control input
    signal GND ~ pin 5  # pack -
    signal CB_EN ~ pin 6  # active-low cell-balance enable
    signal VDD ~ pin 7
    signal OUT ~ pin 8  # overvoltage output
    GND ~ pin 9  # thermal pad
