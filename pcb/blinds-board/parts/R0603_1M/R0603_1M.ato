#pragma experiment("TRAITS")
import has_designator_prefix
import has_part_picked
import is_atomic_part

component R0603_1M_package:
    """
    1M 1% 0603 — the HUSB238A datasheet asks for ~900k when strapping
    its dual-function pins, purely to keep standby current down.
    """
    trait is_atomic_part<manufacturer="UNI-ROYAL(Uniroyal Elec)", partnumber="0603WAF1004T5E", footprint="R0603.kicad_mod", symbol="0603WAF1004T5E.kicad_sym">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C22935", manufacturer="UNI-ROYAL(Uniroyal Elec)", partno="0603WAF1004T5E">
    trait has_designator_prefix<prefix="R">

    # pins
    pin 1
    pin 2
