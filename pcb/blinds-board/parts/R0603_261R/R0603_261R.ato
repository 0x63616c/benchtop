#pragma experiment("TRAITS")
import has_designator_prefix
import has_part_picked
import is_atomic_part

component R0603_261R_package:
    """
    261R 1% 0603 — the BQ29209 datasheet's bottom-cell balance
    resistor (it specifies 260R; 261R is the E96 neighbour).
    """
    trait is_atomic_part<manufacturer="UNI-ROYAL(Uniroyal Elec)", partnumber="0603WAF2610T5E", footprint="R0603.kicad_mod", symbol="0603WAF2610T5E.kicad_sym">
    trait has_part_picked::by_supplier<supplier_id="lcsc", supplier_partno="C22925", manufacturer="UNI-ROYAL(Uniroyal Elec)", partno="0603WAF2610T5E">
    trait has_designator_prefix<prefix="R">

    # pins
    pin 1
    pin 2
